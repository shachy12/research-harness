# Copy to .env and fill in. Used by apps/server until the settings UI exists.

# Which model backend to use:
#   claude-code  the Claude Code CLI with your own Claude login (Pro/Max); install it and run `claude auth login` once
#   anthropic    the Claude API, billed per token (needs ANTHROPIC_API_KEY)
#   placeholder  no model; replies explain how to connect one
# If unset: anthropic when ANTHROPIC_API_KEY is set, otherwise placeholder.
HARNESS_PROVIDER=claude-code

# Only for HARNESS_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional
# Defaults for nodes without their own model setting (each node can pick its own in the app)
# HARNESS_MODEL=claude-sonnet-5-5    # default claude-sonnet-5-5 (always passed, never your account's changing default)
# HARNESS_EFFORT=low                 # low (default) | medium | high | xhigh | max
# HARNESS_ASK_LIMIT=3                # ask_node questions per message before the node needs your approval (0: always ask)
# HARNESS_CLAUDE_PATH=               # claude-code: path to the claude executable if not found automatically
# HARNESS_SERVER_PORT=8787
# HARNESS_DATA_DIR=./data             # database + default project folders (data/projects/<id>/)
# HARNESS_DB=./data/harness.db
